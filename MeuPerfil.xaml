<Window x:Class="CRUD.MeuPerfil"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:CRUD"
        mc:Ignorable="d"
        Title="Meu Perfil" Height="680" Width="800">
    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border Background="White"
                CornerRadius="8"
                Padding="30"
                Width="360"
                SnapsToDevicePixels="True">

            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Color="#CCCCCC" ShadowDepth="2" Opacity="0.5" />
            </Border.Effect>

            <StackPanel>
                <Ellipse x:Name="ImgFotoPerfil"
                         Width="90"
                         Height="90"
                         HorizontalAlignment="Center">
                    <Ellipse.Fill>
                        <ImageBrush ImageSource="https://i.sstatic.net/EYX0L.png" Stretch="UniformToFill" />
                    </Ellipse.Fill>
                </Ellipse>

                <Button Content="Alterar foto de perfil"
                        Background="Transparent"
                        Foreground="#007ACC"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="0 5 0 10" />

                <TextBlock x:Name="LblNomeUsuarioHeader"
                           Text="@usuario_exemplo"
                           FontSize="18"
                           FontWeight="Bold"
                           Foreground="#333333"
                           Margin="0,0,0,25"
                           HorizontalAlignment="Center" />

                <TextBlock Text="Nome" Foreground="#666666" Margin="0,0,0,5" FontSize="12" />
                <TextBox x:Name="TxtNome"
                         Height="35"
                         Margin="0,0,0,15"
                         Padding="5,0"
                         VerticalContentAlignment="Center" />

                <TextBlock Text="Username (@)" Foreground="#666666" Margin="0,0,0,5" FontSize="12" />
                <TextBox x:Name="TxtUsername"
                         Height="35"
                         Margin="0,0,0,15"
                         Padding="5,0"
                         VerticalContentAlignment="Center" />

                <TextBlock Text="E-mail" Foreground="#666666" Margin="0,0,0,5" FontSize="12" />
                <TextBox x:Name="TxtEmail"
                         Height="35"
                         Margin="0,0,0,15"
                         Padding="5,0"
                         VerticalContentAlignment="Center" />

                <TextBlock Text="Nova senha" Foreground="#666666" Margin="0,0,0,5" FontSize="12" />
                <PasswordBox x:Name="TxtNovaSenha"
                             Height="35"
                             Margin="0,0,0,25"
                             Padding="5,0"
                             VerticalContentAlignment="Center" />

                <Button Content="Salvar Alterações"
                        Height="40"
                        Background="#007ACC"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Margin="0,0,0,10"
                        Click="BtnSalvar_OnClick">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5" />
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="Excluir Conta Permanente"
                        Height="35"
                        Background="Transparent"
                        Foreground="#FF4444"
                        FontWeight="SemiBold"
                        BorderThickness="0"
                        Cursor="Hand" 
                        Click="BtnDeletarPerfil_OnClick"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>