<Window x:Class="CRUD.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="clr-namespace:CRUD"
        mc:Ignorable="d"
        Title="Login de Usuário" Height="450" Width="800" WindowStartupLocation="CenterScreen">
    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
        <Border Background="White"
                CornerRadius="8"
                Padding="30"
                Width="320"
                SnapsToDevicePixels="True">

            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Color="#CCCCCC" ShadowDepth="2" Opacity="0.5" />
            </Border.Effect>

            <StackPanel>
                <TextBlock Text="Bem-vindo"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#333333"
                           Margin="0,0,0,25"
                           HorizontalAlignment="Center" />

                <TextBlock Text="Usuário" Foreground="#666666" Margin="0,0,0,5" FontSize="12" />
                <TextBox x:Name="TxtUsuario"
                         Height="35"
                         Margin="0,0,0,15"
                         Padding="5,0"
                         VerticalContentAlignment="Center" />

                <TextBlock Text="Senha" Foreground="#666666" Margin="0,0,0,5" FontSize="12" />
                <PasswordBox x:Name="TxtSenha"
                             Height="35"
                             Margin="0,0,0,25"
                             Padding="5,0"
                             VerticalContentAlignment="Center" />

                <Button Content="Entrar"
                        Height="40"
                        Background="#007ACC"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0"
                        Margin="0,0,0,15"
                        Click="BtnLogin_OnClick">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5" />
                        </Style>
                    </Button.Resources>
                </Button>

                <Button Content="Não tem uma conta? Cadastre-se"
                        Background="Transparent"
                        Foreground="#007ACC"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="ButtonCadastro_OnClick"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>