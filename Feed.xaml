<Window x:Class="CRUD.Feed"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:modelos="clr-namespace:CRUD.Modelos"
        mc:Ignorable="d"
        Title="Feed" Height="650" Width="420" Background="#F5F5F5">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFFFFF" Padding="20" SnapsToDevicePixels="True" Margin="0 0 0 15">
            <Border.Effect>
                <DropShadowEffect BlurRadius="10" Color="#CCCCCC" ShadowDepth="1" Opacity="0.3" />
            </Border.Effect>
            <TextBlock Text="Seu Feed" FontSize="23" FontWeight="Bold" Foreground="#333333"
                       HorizontalAlignment="Center" />
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden">
            <StackPanel>
                <ItemsControl x:Name="ItemsControlFeed">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="modelos:Postagem">
                            <Border BorderBrush="#E5E7EB" BorderThickness="1" Margin="15 0 15 10"
                                    Padding="15" Background="#FFFFFF">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10">
                                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                                            <TextBlock Text="{Binding Usuario.Nome}"
                                                       FontWeight="Bold"
                                                       FontSize="14"
                                                       Foreground="#111827" />
                                            <TextBlock Text="{Binding Usuario.Username, StringFormat='@{0}'}"
                                                       Foreground="#374151"
                                                       FontSize="13"
                                                       Margin="5,0,0,0"
                                                       Opacity="0.7" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Postado_em, StringFormat='dd MMM - HH:mm'}"
                                                   Foreground="#374151"
                                                   FontSize="12"
                                                   Opacity="0.5"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center" />
                                    </DockPanel>

                                    <TextBlock
                                        Text="{Binding Conteudo}"
                                        TextWrapping="Wrap"
                                        FontSize="14"
                                        Foreground="#374151"
                                        Margin="0,0,0,15" />
                                    <StackPanel Orientation="Horizontal">
                                        <Border Background="#2563EB" Height="35"
                                                Width="100" HorizontalAlignment="Left" CornerRadius="5">
                                            <Button Content="♡ Curtir"
                                                    Background="Transparent"
                                                    Foreground="White"
                                                    FontWeight="Bold"
                                                    BorderThickness="0"
                                                    Cursor="Hand" Click="BtnCurtir_OnClick"
                                                    Tag="{Binding}">
                                            </Button>
                                        </Border>
                                        <TextBlock Text="{Binding Curtidas, StringFormat='{}{0} curtidas'}"
                                                   VerticalAlignment="Center" Margin="10 0 0 0" FontSize="14"
                                                   Foreground="#007ACC" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>