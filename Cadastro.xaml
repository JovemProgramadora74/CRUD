<Window x:Class="CRUD.Cadastro"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Cadastro de Usuário" Height="450" Width="800" WindowStartupLocation="CenterScreen">
    <Grid VerticalAlignment="Center" HorizontalAlignment="Center" Width="360">
        <Border Background="White"
                CornerRadius="8"
                Padding="30"
                SnapsToDevicePixels="True">

            <Border.Effect>
                <DropShadowEffect BlurRadius="15" Color="#CCCCCC" ShadowDepth="2" Opacity="0.5" />
            </Border.Effect>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Criar Conta"
                           FontSize="24"
                           FontWeight="Bold"
                           Foreground="#333333"
                           Margin="0,0,0,10"
                           HorizontalAlignment="Center" />

                <Label Content="Nome:" Foreground="#666666" FontSize="12" />
                <TextBox Margin="0 0 0 10" Height="35" x:Name="TxtNome" VerticalContentAlignment="Center"
                         Padding="5,0" />

                <Label Content="E-mail:" Foreground="#666666" FontSize="12" />
                <TextBox Margin="0 0 0 10" Height="35" x:Name="TxtEmail" VerticalContentAlignment="Center"
                         Padding="5,0" />

                <Label Content="Username:" Foreground="#666666" FontSize="12" />
                <TextBox Margin="0 0 0 10" Height="35" x:Name="TxtUsername" VerticalContentAlignment="Center"
                         Padding="5,0" />

                <Label Content="Senha:" Foreground="#666666" FontSize="12" />
                <PasswordBox Margin="0 0 0 20" Height="35" x:Name="TxtSenha" VerticalContentAlignment="Center"
                             Padding="5,0" />

                <Button Content="Cadastrar"
                        Height="40"
                        Click="BtnCadastrar_OnClick"
                        Background="#007ACC"
                        Foreground="White"
                        FontWeight="Bold"
                        BorderThickness="0">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="5" />
                        </Style>
                    </Button.Resources>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>