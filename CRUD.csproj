<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net8.0-windows</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <UseWPF>true</UseWPF>
        <UserSecretsId>c1edcece-caae-48f2-9f74-1a94d2e1d338</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="DotNetEnv" Version="3.2.0"/>
        <PackageReference Include="MySql.EntityFrameworkCore" Version="8.0.26"/>
        <PackageReference Include="Npgsql" Version="10.0.3"/>
    </ItemGroup>

    <ItemGroup>
        <None Include="bin\Debug\net8.0-windows\.env"/>
    </ItemGroup>

    <ItemGroup>
        <Folder Include="bin\Debug\net8.0-windows\"/>
    </ItemGroup>

    <ItemGroup>
        <None Remove="Resources\icon.png"/>
    </ItemGroup>

    <ItemGroup>
        <None Remove="Recursos\icon.png"/>
        <Resource Include="Recursos\icon.png"/>
    </ItemGroup>

</Project>
